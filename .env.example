# Sonda do ARI (cmd/probe). Este arquivo e exemplo; crie .env ao lado (ignorado
# pelo git) com os valores reais.
#
# ATENCAO: SHARD_ID e obrigatorio e NAO pode ser vazio. A sonda conecta no app
# "connect-<SHARD_ID>"; usar o app "connect" de producao faria o Asterisk dividir
# os eventos entre a sonda e o worker ao vivo.
SHARD_ID=probe
ASTERISK_ARI_URL=https://ari.lai.ia.br
ASTERISK_ARI_APP=connect
ASTERISK_ARI_USERNAME=connect-ari
ASTERISK_ARI_PASSWORD=
PROBE_SECONDS=25
