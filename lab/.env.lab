# Envs do worker-ari-go e do mini-back contra o laboratorio.
#   set -a && . ./.env.lab && set +a
SHARD_ID=lab
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_APP=connect
ASTERISK_ARI_USERNAME=connect-ari
ASTERISK_ARI_PASSWORD=lab-ari-secret
SIP_TRUNK_ENDPOINT=trunk
CALL_RING_TIMEOUT_SECONDS=20
DATABASE_URL=postgres://lab:lab@127.0.0.1:5433/lab
REDIS_URL=redis://127.0.0.1:6380
NATS_URL=nats://127.0.0.1:4224
ARI_SHARD_REGISTRY_KEY=ari:shards
ARI_MAX_CALLS=50
PORT=8091
