# Envs do worker-ari-go e do mini-back contra o laboratorio.
#   set -a && . ./.env.lab && set +a
SHARD_ID=lab
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_APP=connect
ASTERISK_ARI_USERNAME=connect-ari
ASTERISK_ARI_PASSWORD=lab-ari-secret
SIP_TRUNK_ENDPOINT=trunk
CALL_RING_TIMEOUT_SECONDS=20
DATABASE_URL=postgres://lab:lab@127.0.0.1:5433/lab
REDIS_URL=redis://127.0.0.1:6380
NATS_URL=nats://127.0.0.1:4224
ARI_SHARD_REGISTRY_KEY=ari:shards
ARI_MAX_CALLS=5000
PORT=8091

# S3 das gravacoes, contra o LocalStack do compose.
#
# S3Config.Enabled() (internal/config/config.go) exige Bucket E AccessKeyID nao
# vazios: sem os dois, o Orchestrator sobe com o uploader nil e uploadRecording
# devolve (false, nil) sem gravar nada e SEM ERRO — a gravacao some em silencio,
# que e exatamente o modo de falha que este wiring existe para nao repetir.
#
# O bucket e criado pelo Terraform: cd ../../call-infra && make apply
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_S3_BUCKET_NAME=lab-recordings
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
