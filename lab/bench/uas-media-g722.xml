<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- Ponta que atende falando SO G.722, para FORCAR TRANSCODING.

     Existe por uma lacuna do primeiro benchmark: os dois lados falavam
     ulaw/alaw, entao o Asterisk ficava em passthrough e a variavel de maior
     peso do plano de capacidade (transcoding derruba `calls_por_no` em ~3x)
     nunca foi exercitada. Com esta perna em G.722 e a outra em G.711, o
     Asterisk tem de decodificar ADPCM de 16 kHz, reamostrar e recodificar:
     trabalho de DSP de verdade, por amostra, em cada sentido.

     O AUDIO AQUI E RUIDO, DE PROPOSITO. O `g722-10s.pcap` tem bytes sinteticos,
     porque nao ha codificador de G.722 no `mkpcap.py`. Isso NAO afeta a medicao
     de CPU (decodificar ADPCM custa o mesmo com lixo ou com voz) mas invalida
     qualquer leitura de QUALIDADE nesta perna: perda e jitter continuam
     validos, MOS nao. Para ouvir a gravacao, use o cenario alaw.

     O laco de midia e o mesmo do `uas-media.xml`; a explicacao esta la. -->
<scenario name="uas com midia em laco (g722, forca transcoding)">

  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 9
      a=rtpmap:9 G722/8000
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true"/>

  <!-- Inicio do laco de midia. -->
  <label id="1"/>

  <!-- Toca o audio. Nao bloqueia: o play roda em outra thread e o cenario segue
       direto para o recv abaixo enquanto o RTP flui. -->
  <nop>
    <action>
      <exec play_pcap_audio="/bench/media/g722-10s.pcap"/>
    </action>
  </nop>

  <!-- Segura ate o desligamento vir de quem manda: o worker, via terminate.
       Se em 10,3s nao veio BYE, volta ao label 1 e toca de novo - e assim a
       midia dura o quanto a chamada durar. -->
  <recv request="BYE" timeout="10300" ontimeout="1"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <ResponseTimeRepartition value="10, 20, 50, 100, 200, 500, 1000"/>
</scenario>
