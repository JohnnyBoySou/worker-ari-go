<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- Ponta que atende E TOCA AUDIO durante a chamada inteira.
     O cenario embutido `-sn uas` responde SIP mas nao envia RTP: um benchmark
     em cima dele mediria so sinalizacao e bridge, e a capacidade real de um no
     e limitada pela MIDIA.

     POR QUE UM PCAP LONGO E NAO UM LACO. O `play_pcap_audio` toca uma vez, e
     com um arquivo de duracao desconhecida o RTP parava no meio de um teste que
     segura a chamada por 15s. A correcao obvia era um laco (`ontimeout`
     rearmando o play), e ela FOI TENTADA E MEDIDA: mantem a midia fluindo e
     destroi a estatistica, porque o SIPp replica o pcap byte a byte e cada
     volta reinicia a sequencia RTP em 0 com o mesmo SSRC. Aos 5s e aos 13s o
     canal reportava `lp=0`; na segunda volta, `lp=65036` (-500 em 16 bits, e
     500 era o numero de pacotes do pcap) e o `txmes` do Asterisk caindo de 88
     para 20.

     Entao o pcap tem 300s e toca uma vez so: a sequencia nunca volta atras, a
     perda e o jitter continuam medindo o que dizem medir, e 300s cobrem
     qualquer rodada. Gere com `python3 bench/mkpcap.py`. -->
<scenario name="uas com midia (alaw)">

  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 0
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true"/>

  <!-- Toca o audio. Nao bloqueia: o play roda em outra thread e o cenario segue
       direto para o recv abaixo enquanto o RTP flui. -->
  <nop>
    <action>
      <exec play_pcap_audio="/bench/media/alaw-300s.pcap"/>
    </action>
  </nop>

  <!-- Segura ate o desligamento vir de quem manda: o worker, via terminate. -->
  <recv request="BYE" timeout="600000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <ResponseTimeRepartition value="10, 20, 50, 100, 200, 500, 1000"/>
</scenario>
